From 92a4be29b28a809bb4fb1b1df736c652ad80f1bc Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 11:03:56 -0300
Subject: [PATCH] Nam, Cab: library index parameter (model_index / ir_index) in
 LV2 builds only

VST3, AU and Standalone no longer get the parameter, so it never shows up in
a DAW's automation lists and can't unload a model or IR by accident.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ECLxpAC4FVxhB2o1EABz3i
---
 plugins/Cab/README.md |  6 ++++--
 plugins/Nam/README.md |  6 ++++--
 shared/MelonLibrary.h | 19 ++++++++++++++++++-
 3 files changed, 26 insertions(+), 5 deletions(-)

diff --git a/plugins/Cab/README.md b/plugins/Cab/README.md
index 512c25a..d4f0b63 100644
--- a/plugins/Cab/README.md
+++ b/plugins/Cab/README.md
@@ -31,15 +31,17 @@ The panel under the preset row is the **IR File Loader**. Click the IR name to o
 
 ## Library index (Melon Pedal)
 
+**LV2 only.** VST3, AU and Standalone don't have this parameter, so it never shows up in a DAW.
+
 Hosts without a plugin window, like the Melon Pedal (mod-host), choose the IR with the
 **`ir_index`** parameter instead of the file loader:
 
 | Value | Result |
 |---|---|
-| `-1` (default) | No IR; unloads the current one. Desktop use is unchanged. |
+| `-1` (default) | No IR; unloads the current one. |
 | `0`…`65535` | The file at that position in the library list. Past the end of the list = no IR, with a message in the status line. |
 
-- **Library folder:** `$MELON_IR_DIR` if set, otherwise `/data/media/IR` on Linux, or `Documents/Melon Plugins/Library/IR` on Windows and macOS.
+- **Library folder:** `$MELON_IR_DIR` if set, otherwise `/data/media/IR` on Linux, or `Documents/Melon Plugins/Library/IR` elsewhere.
 - **List:** every `.wav` / `.aif` / `.aiff` / `.flac` file in that folder and all its sub-folders. Names starting with `.` are skipped, along with hidden folders. Sorted by relative path (`/` separators, UTF-8 byte order). The code is in `shared/MelonLibraryScan.h`; the pedal's `library.py` must produce the same order.
 - **Example:** `patch_set 0 https://github.com/melon-audio/melon-cab:ir_index 12`
 - The saved file path in a project or user preset still wins over the index.
diff --git a/plugins/Nam/README.md b/plugins/Nam/README.md
index 8ecb434..e768680 100644
--- a/plugins/Nam/README.md
+++ b/plugins/Nam/README.md
@@ -32,15 +32,17 @@ Models load on a background thread, so there are no audio dropouts when you swit
 
 ## Library index (Melon Pedal)
 
+**LV2 only.** VST3, AU and Standalone don't have this parameter, so it never shows up in a DAW.
+
 Hosts without a plugin window, like the Melon Pedal (mod-host), choose the model with the
 **`model_index`** parameter instead of the file loader:
 
 | Value | Result |
 |---|---|
-| `-1` (default) | No model; unloads the current one. Desktop use is unchanged. |
+| `-1` (default) | No model; unloads the current one. |
 | `0`…`65535` | The file at that position in the library list. Past the end of the list = no model, with a message in the status line. |
 
-- **Library folder:** `$MELON_NAM_DIR` if set, otherwise `/data/media/NAM` on Linux, or `Documents/Melon Plugins/Library/NAM` on Windows and macOS.
+- **Library folder:** `$MELON_NAM_DIR` if set, otherwise `/data/media/NAM` on Linux, or `Documents/Melon Plugins/Library/NAM` elsewhere.
 - **List:** every `.nam` / `.aidax` / `.json` file in that folder and all its sub-folders. Names starting with `.` are skipped, along with hidden folders. Sorted by relative path (`/` separators, UTF-8 byte order). The code is in `shared/MelonLibraryScan.h`; the pedal's `library.py` must produce the same order.
 - **Example:** `patch_set 0 https://github.com/melon-audio/melon-nam:model_index 12`
 - The saved file path in a project or user preset still wins over the index.
diff --git a/shared/MelonLibrary.h b/shared/MelonLibrary.h
index 0f62b74..c89ec7e 100644
--- a/shared/MelonLibrary.h
+++ b/shared/MelonLibrary.h
@@ -5,7 +5,11 @@
 //
 //     patch_set 0 https://github.com/melon-audio/melon-nam:model_index 12
 //
-//   -1        no file (unloads the current one). Default, so desktop users see no change.
+// LV2 builds only: VST3, AU and Standalone don't get the parameter, so DAW users never see it in
+// their automation lists. JUCE sets the format before the plugin is created, both when it runs and
+// when the build writes the LV2 .ttl files, so the parameter list always matches.
+//
+//   -1        no file (unloads the current one). Default.
 //   0..65535  the file at that position in the library list (MelonLibraryScan.h);
 //             past the end of the list = no file, with a message in the status line.
 //
@@ -27,8 +31,17 @@ class LibrarySelector : private juce::AudioProcessorValueTreeState::Listener, pr
 public:
     static constexpr int kMaxIndex = 65535;
 
+    // True when this instance is the LV2 version (the Melon Pedal runs LV2 in mod-host).
+    static bool enabled()
+    {
+        return juce::PluginHostType::getPluginLoadedAs() == juce::AudioProcessor::wrapperType_LV2;
+    }
+
+    // Adds the parameter in LV2 builds only (see enabled()).
     static void addParameter (juce::AudioProcessorValueTreeState::ParameterLayout& l, const juce::String& id, const juce::String& name)
     {
+        if (! enabled())
+            return;
         l.add (std::make_unique<juce::AudioParameterInt> (
             juce::ParameterID { id, 1 }, name, -1, kMaxIndex, -1,
             juce::AudioParameterIntAttributes()
@@ -56,12 +69,16 @@ public:
 
     void start()
     {
+        if (apvts.getParameter (id) == nullptr)
+            return;                       // not LV2: no parameter, no thread
         apvts.addParameterListener (id, this);
         startThread (juce::Thread::Priority::low);
     }
 
     void stop()
     {
+        if (apvts.getParameter (id) == nullptr)
+            return;
         apvts.removeParameterListener (id, this);
         signalThreadShouldExit();
         notify();
-- 
